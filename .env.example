# DarkStore Analytics Platform - environment variables
# Copy this file to .env. Every variable is optional.

# Optional. Only the chatbot needs this; everything else runs without it.
# Without a key, POST /api/v1/chat returns 503.
# Create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional. Gemini model used by the chatbot (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# Service URLs (only needed if running services on non-default ports)
# DATA_SERVICE_URL=http://localhost:8001
# FORECASTER_SERVICE_URL=http://localhost:8002
# ROUTE_OPTIMIZER_SERVICE_URL=http://localhost:8003
# ANOMALY_DETECTOR_SERVICE_URL=http://localhost:8004
# AFFINITY_ANALYZER_SERVICE_URL=http://localhost:8005
# EVENT_SIMULATOR_SERVICE_URL=http://localhost:8006
# GATEWAY_URL=http://localhost:8000
